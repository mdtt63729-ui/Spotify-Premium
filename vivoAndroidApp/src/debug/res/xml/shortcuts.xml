<?xml version="1.0" encoding="utf-8"?>
<!-- vivo debug build: a copy of src/release/res/xml/shortcuts.xml. vivo keeps its package in debug (no .dev suffix), so debug needs the same override as release: keep the two in step. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="home"
        android:enabled="true"
        android:icon="@drawable/round_home_24"
        android:shortcutShortLabel="@string/home">
        <intent
            android:targetClass="com.manikdev.spotify.MainActivity"
            android:targetPackage="com.spotify.music"
            android:action="com.manikdev.spotify.action.HOME" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/round_search_24"
        android:shortcutShortLabel="@string/search">
        <intent
            android:targetClass="com.manikdev.spotify.MainActivity"
            android:targetPackage="com.spotify.music"
            android:action="com.manikdev.spotify.action.SEARCH" />
    </shortcut>
    <shortcut
        android:shortcutId="library"
        android:enabled="true"
        android:icon="@drawable/round_library_music_24"
        android:shortcutShortLabel="@string/library">
        <intent
            android:targetClass="com.manikdev.spotify.MainActivity"
            android:targetPackage="com.spotify.music"
            android:action="com.manikdev.spotify.action.LIBRARY" />
    </shortcut>
</shortcuts>